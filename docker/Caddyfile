# Proxy inverso con HTTPS automático (Let's Encrypt).
# El sistema se sirve en https://www.bingohit.cl/sistema/ (app, API de la plataforma, Socket.IO y WebRTC).
# ACME_EMAIL se lee del fichero .env (avisos de caducidad de certificados).

{
    email {$ACME_EMAIL}
}

www.bingohit.cl {
    encode gzip

    # /sistema -> /sistema/ (la app necesita la barra final)
    redir /sistema /sistema/ permanent

    # Se quita el prefijo y se pasa al servidor Concert (sirve la app, /api, /socket.io y /sfu).
    handle_path /sistema/* {
        reverse_proxy concert:3010
    }

    # Resto del sitio. De momento redirige al sistema; sustituye este bloque por tu web,
    # por ejemplo:  handle { root * /srv/www ; file_server }
    handle {
        redir * /sistema/ temporary
    }
}

# El dominio sin "www" redirige al principal.
bingohit.cl {
    redir https://www.bingohit.cl{uri} permanent
}
