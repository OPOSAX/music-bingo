# Copia este fichero a .env y ajusta los valores.

# Puerto HTTP publicado por el servicio "app" (perfil por defecto, sin HTTPS).
APP_PORT=8080

# Solo para el perfil "https": dominio que apunta al servidor y correo para Let's Encrypt.
# Recuerda registrar https://DOMINIO/ como Redirect URI en el panel de Spotify.
DOMAIN=bingo.ejemplo.com
ACME_EMAIL=tu@correo.com
