{
  "name": "music-bingo",
  "version": "1.0.0",
  "description": "Bingo musical conectado a Spotify Premium. Sin backend ni dependencias de ejecución.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node serve.mjs",
    "dev": "node serve.mjs --watch",
    "test": "tsc -p tsconfig.test.json && node --test \"./.test-out/tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  },
  "license": "MIT"
}
