# Proxy inverso con HTTPS automático (Let's Encrypt) para www.paolosaxton.com.
# ACME_EMAIL se lee del fichero .env (aviso de caducidad de certificados).

{
    email {$ACME_EMAIL}
}

www.paolosaxton.com {
    encode gzip
    reverse_proxy app:80
}

# El dominio sin "www" redirige al principal.
paolosaxton.com {
    redir https://www.paolosaxton.com{uri} permanent
}
