# Copia este fichero a .env y ajusta los valores.

# Puerto HTTP publicado por el servicio "app" (perfil por defecto, sin HTTPS).
APP_PORT=8080

# Solo para el perfil "https": correo para los avisos de Let's Encrypt.
# El dominio (www.bingohit.cl) está definido en docker/Caddyfile.
# Recuerda registrar https://www.bingohit.cl/sistema/ como Redirect URI en el panel de Spotify.
ACME_EMAIL=tu@correo.com

# ---- Karaoke (modo concierto), ver docs/CONCERT_MODE.md ----
# Estas variables las lee el servidor B-Talk; el panel del DJ las guarda en el navegador.
CONCERT_MODE=false
MAX_LIVE_MICS=2
MAX_PREPARED_MICS=2
CONCERT_AUDIO_PROFILE=SING
CONCERT_NOISE_REDUCTION=LIGHT
AEC_ENABLED=true
REFERENCE_AUDIO_MODE=MIXER
BTALK_URL=
BTALK_API_URL=
# Servidor Concert (perfil "concert" de docker compose): token del DJ y IP anunciada por mediasoup.
CONCERT_DJ_TOKEN=cambia-este-secreto
CONCERT_ADMIN_TOKEN=
BTALK_ANNOUNCED_IP=
CONCERT_PORT=3010

# ---- Bingo Hit Live (animador en vídeo + audio del evento), ver docs/CONCERT_MODE.md § Live ----
# El animador entra al panel /live con este token (si falta, se usa CONCERT_DJ_TOKEN).
LIVE_HOST_TOKEN=
# Servidores ICE que el servidor entrega a los clientes (nunca en el código del cliente).
STUN_SERVER_URL=stun:stun.l.google.com:19302
# TURN para jugadores tras NAT/CGNAT/redes corporativas. Con TURN_SECRET (coturn REST API) las credenciales son temporales.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
# Orientativo para el panel; la capacidad real depende del ancho de banda del SFU (~1.3 Mb/s por espectador en 720p).
LIVE_MAX_VIEWERS=5000

# ---- Plataforma Bingo Hit (animadores, eventos, tarjetas, pagos centralizados), ver docs/PLATFORM.md ----
# Administrador General: usuario y contraseña para #/login (el script de instalación genera la contraseña).
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=cambia-esta-contrasena
# Token de API del administrador (si falta se genera uno por arranque y sale en el log).
PLATFORM_ADMIN_TOKEN=cambia-este-secreto-admin
# Fichero JSON de datos (o "memory" para pruebas). En Docker se monta ./server/data.
PLATFORM_DATA_FILE=
# URL pública de la app/API (para redirecciones de pago y webhooks).
PUBLIC_URL=https://www.bingohit.cl/sistema
# Proveedor de pago activo: mock | transbank | mercadopago (también configurable desde el panel de administración).
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=cambia-este-secreto-mock
# Desactiva el simulador de pagos en producción.
MOCK_PAYMENTS=true
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=integration
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
